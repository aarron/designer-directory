generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Designer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  email     String  @unique
  bio       String? @db.Text
  photoUrl  String?

  title      String?
  company    String?
  linkedinUrl String?
  websiteUrl  String?

  primaryRole     String
  otherRoles      String[]
  location        String
  experienceLevel String
  typeOfRole      String[]
  companySize     String[]  @default([])
  skills          String[]  @default([])
  industries      String[]  @default([])
  startAvailability String?
  remotePreference  String?
  compensation    String?
  requiresVisa    Boolean  @default(false)

  openToWork WorkStatus @default(OPEN)
  timing     String?

  publicProfile       Boolean @default(true)
  shareConfidentially Boolean @default(false)
  hidden              Boolean   @default(false)
  lastConfirmedAt     DateTime?
  confirmSentAt       DateTime?
  profileViews        Int       @default(0)

  // Featured work
  projects        Json?     @default("[]")

  // Fun profile extras
  funFacts        String?   @db.Text
  mostProudOf     String?
  pets            String?
  recentlyRead    String?
  languagesSpoken String[]  @default([])
  instruments     String?
  hobbies         String?

  editToken        String    @unique @default(cuid())
  magicToken       String?   @unique
  magicTokenExpiry DateTime?

  @@index([publicProfile, hidden, openToWork])
  @@map("designers")
}

enum WorkStatus {
  OPEN
  OPEN_SOON
  NOT_LOOKING
}

model SuccessStory {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  designerId   String
  designerName String
  quote        String   @db.Text
  company      String?
  newRole      String?
  approved     Boolean  @default(false)
  public       Boolean  @default(false)

  @@map("success_stories")
}

model JobMatchLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  jobId      String
  designerId String
  score      Int

  @@unique([jobId, designerId])
  @@map("job_match_logs")
}

model Coupon {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  code          String    @unique
  description   String?
  discountType  String
  discountValue Int
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)

  @@map("coupons")
}

model Job {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posterFirstName String
  posterLastName  String
  posterEmail     String

  company        String
  companyUrl     String?
  companyLogoUrl String?

  title           String
  role            String
  description     String?  @db.Text
  jobUrl          String?
  location        String
  remote          Boolean  @default(false)
  experienceLevel String
  compensation    String?
  visaSponsorship Boolean  @default(false)
  typeOfRole      String
  companySize     String?

  active    Boolean   @default(false)
  featured  Boolean   @default(false)
  expiresAt DateTime?

  stripeSessionId     String? @unique
  stripePaymentStatus String?

  viewCount   Int    @default(0)
  manageToken String @unique @default(cuid())

  matchFrequency    String?   // "once" | "weekly" | "biweekly"
  lastMatchSentAt   DateTime?
  repostNudgeSentAt DateTime?

  @@index([active, createdAt])
  @@map("jobs")
}
